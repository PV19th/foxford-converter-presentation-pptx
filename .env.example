# Скопируйте этот файл в .env и заполните. Файл .env в репозиторий не попадает.

# Общий пароль для входа на сайт
APP_PASSWORD=

# Любая длинная случайная строка. Без неё вход сбрасывается при каждом перезапуске сайта
SECRET_KEY=

# Самый большой размер загружаемого файла, МБ
MAX_UPLOAD_MB=100

# Через сколько часов удалять загруженные и готовые файлы
JOB_TTL_HOURS=24

# Контакт для кнопки «Сообщить автору»
SUPPORT_CONTACT=

# ИИ (пока не используется)
ANTHROPIC_API_KEY=
