# Скопируйте этот файл в .env и заполните. Файл .env в репозиторий не попадает.

# Общий пароль для входа на сайт
APP_PASSWORD=

# Любая длинная случайная строка. Без неё вход сбрасывается при каждом перезапуске сайта
SECRET_KEY=

# Самый большой размер загружаемого файла, МБ
MAX_UPLOAD_MB=100

# Через сколько часов удалять загруженные и готовые файлы
JOB_TTL_HOURS=24

# Контакт для кнопки «Сообщить автору»
SUPPORT_CONTACT=

# ИИ-доработка (без ключа кнопки «Доработать с ИИ» нет). Напрямую у Anthropic — ANTHROPIC_API_KEY;
# через посредника DS Lab — ANTHROPIC_BASE_URL=https://api.dslab.tech и ANTHROPIC_AUTH_TOKEN (ключ DS Lab).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# дневной лимит расходов на ИИ, ₽
AI_DAILY_LIMIT_RUB=1000
